{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "eleicoes",
    "workers_dev": false,
    "preview_urls": false,
    "compatibility_date": "2026-10-02",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
    },
    "compatibility_flags": [
        "nodejs_compat"
    ]
}